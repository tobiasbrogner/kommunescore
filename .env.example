DATABASE_URL=postgresql://kommunescore:kommunescore@localhost:5432/kommunescore

# Bruges kun af scripts/seed-admin.ts til at oprette den ene administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Delt nøgle til app/api/intern/revalider (generér fx med: openssl rand -hex 32).
REVALIDATE_SECRET=

# Kun for hostet database (Aiven): CA-certifikatet (PEM) fra Aiven-konsollen.
# Sæt i dobbelte anførselstegn over flere linjer, eller med \n som linjeskift.
DATABASE_CA_CERT=

# Token til Dataforsyningens Gsearch (adressesøgningen under Pendling). Gratis bruger på
# dataforsyningen.dk. Mangler den, bruges Photon (OpenStreetMap) i stedet.
GSEARCH_TOKEN=

# API-nøgle til Claude, som "Spørg hjælperen" på kortet bruger (console.anthropic.com).
# Mangler den, svarer chatten, at den ikke er sat op endnu.
ANTHROPIC_API_KEY=

# Sidens egen adresse. Bruges af seed-scripts til at rydde cachen og af PDF-udskriften
# af kommunerapporten. Lokalt kan den udelades (standard: http://localhost:3000);
# sæt den til det rigtige domæne hos hostingen.
APP_URL=
